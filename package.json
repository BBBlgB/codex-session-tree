{
  "name": "codex-session-tree",
  "displayName": "Codex 会话树",
  "description": "查看 Codex 会话分支关系，悬停查看模型与强度，点击节点切换会话。",
  "version": "0.1.0",
  "publisher": "local-tools",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/BBBlgB/codex-session-tree.git" },
  "engines": { "vscode": "^1.96.2" },
  "categories": ["Other"],
  "keywords": ["codex", "session", "tree", "branch"],
  "main": "./src/extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onUri"],
  "contributes": {
    "commands": [
      { "command": "codexSessionTree.open", "title": "打开会话关系图", "category": "Codex 会话树", "icon": "$(type-hierarchy)" },
      { "command": "codexSessionTree.refresh", "title": "刷新", "category": "Codex 会话树", "icon": "$(refresh)" },
      { "command": "codexSessionTree.settings", "title": "设置", "category": "Codex 会话树", "icon": "$(settings-gear)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "codexSessionTree", "title": "Codex 会话树", "icon": "media/tree.svg" }]
    },
    "views": { "codexSessionTree": [{ "id": "codexSessionTree.view", "name": "会话关系", "type": "webview" }] },
    "menus": {
      "view/title": [
        { "command": "codexSessionTree.open", "when": "view == codexSessionTree.view", "group": "navigation@1" },
        { "command": "codexSessionTree.refresh", "when": "view == codexSessionTree.view", "group": "navigation@2" },
        { "command": "codexSessionTree.settings", "when": "view == codexSessionTree.view" }
      ]
    },
    "configuration": {
      "title": "Codex 会话树",
      "properties": {
        "codexSessionTree.codexHome": { "type": "string", "default": "", "scope": "machine", "description": "本机会话数据目录。留空使用 CODEX_HOME 或用户目录下的 .codex。" },
        "codexSessionTree.pythonPath": { "type": "string", "default": "", "scope": "machine", "description": "Python 3 可执行文件路径。Windows 默认使用 py -3，其他系统使用 python3。需要 Python 3.10 或更新版本。" },
        "codexSessionTree.refreshSeconds": { "type": "number", "default": 10, "minimum": 3, "maximum": 300, "description": "视图可见时自动刷新间隔（秒）。" }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:python": "py -3 -m unittest discover -s test -p test_*.py",
    "package": "vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": { "@vscode/vsce": "^3.6.0", "@vscode/test-electron": "^2.5.2", "@playwright/test": "^1.56.0" }
}
